# Source: one Neon DB per store (markets_db_farm). Every DATABASE_URL_<STORE>
# is read; <STORE> lowercased becomes store_name. Copy them from markets_db_farm/.env.
DATABASE_URL_DROGASIL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_DROGARAIA=postgresql://user:password@host/db?sslmode=require
# ...

# Target: PFPB tables (pfpb_elenco, pfpb_produtos, pfpb_farmacias). Never read as a store.
DATABASE_URL_PFPB=postgresql://user:password@host/db?sslmode=require

# Google Geocoding key. pharmacies.py sends at most 1,000 requests per week.
GEOCODE_API=
